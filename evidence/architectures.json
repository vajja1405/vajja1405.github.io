      {
        "id": "scenarios",
        "label": "Scenario matrix",
        "sub": "15 personas · 5 categories",
        "col": 0,
        "row": 0,
        "detail": {
          "purpose": "Defines each synthetic patient's identity, goal and what to check.",
          "input": "—",
          "output": "System prompt for the patient",
