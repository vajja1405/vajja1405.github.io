[
  {
    "id": "arch.dia",
    "entity": "dia",
    "title": "Drug Interaction Agent",
    "note": "Two paths behind one FastAPI service. Only components present in the repository are shown.",
    "lanes": [
      {
        "row": 0,
        "label": "Label review (public, no LLM)"
      },
      {
        "row": 2,
        "label": "RAG research mode"
      }
    ],
    "nodes": [
      {
        "id": "ui",
        "label": "React + TypeScript",
        "sub": "Vite SPA",
        "col": 0,
        "row": 1,
        "detail": {
          "purpose": "Medication search, pair matrix, filters, quoted label context and a downloadable report.",
          "input": "User-selected RxNorm concepts",
          "output": "Review requests to /api/v2/review",
          "why": "Makes coverage gaps and source passages inspectable instead of producing one verdict.",
          "claims": [
            "dia.frontend"
          ]
        }
      },
      {
        "id": "api",
        "label": "FastAPI",
        "sub": "one Docker container",
        "col": 1,
        "row": 1,
        "detail": {
          "purpose": "Serves the React build and both API paths from one origin on a Hugging Face Space.",
          "input": "HTTP requests",
          "output": "Review results or research reports",
          "why": "Same-origin serving keeps deployment to a single non-root container.",
          "claims": [
            "dia.shipped",
            "dia.admission"
          ]
        }
      },
      {
        "id": "rxnorm",
        "label": "RxNorm catalog",
        "sub": "23,651 terms",
        "col": 2,
        "row": 0,
        "detail": {
          "purpose": "Normalises names to RxCUI concepts (ingredients, combinations, brands).",
          "input": "Search text",
          "output": "RxCUI concept",
          "why": "Explicit concept selection avoids fuzzy name matching later.",
          "claims": [
            "dia.catalog"
          ]
        }
      },
      {
        "id": "dailymed",
        "label": "DailyMed lookup",
        "sub": "bounded, 4 workers",
        "col": 3,
        "row": 0,
        "detail": {
          "purpose": "Retrieves a bounded sample of human prescription/OTC labels per concept.",
          "input": "RxCUI",
          "output": "Label XML with versions",
          "why": "Fixed origins, deadlines and size bounds keep a public endpoint predictable.",
          "observed": "HTTP failures are not cached as 'no label'.",
          "claims": [
            "dia.bounded_retrieval"
          ]
        }
      },
      {
        "id": "ingredient",
        "label": "Ingredient-set check",
        "sub": "identity + negation",
        "col": 4,
        "row": 0,
        "detail": {
          "purpose": "Keeps only labels whose active ingredients exactly match the concept.",
          "input": "Label + selected concept",
          "output": "Accepted label sections",
          "why": "Stops a combination product from standing in for a single ingredient.",
          "claims": [
            "dia.ingredient_check"
          ]
        }
      },
      {
        "id": "matrix",
        "label": "Pair matrix",
        "sub": "≤190 pairs + coverage",
        "col": 5,
        "row": 0,
        "detail": {
          "purpose": "Classifies each pair as ingredient overlap, direct label mention, no direct mention, or incomplete sources.",
          "input": "Accepted sections for 2–20 concepts",
          "output": "Per-pair categories with quotes",
          "why": "'No direct mention' is shown as coverage, never as safety.",
          "claims": [
            "dia.pairs",
            "dia.no_llm_review"
          ]
        }
      },
      {
        "id": "retrieval",
        "label": "FAISS retrieval",
        "sub": "exact → semantic → filter",
        "col": 2,
        "row": 2,
        "detail": {
          "purpose": "Finds evidence for a drug pair.",
          "input": "Drug pair",
          "output": "Documents that mention both drugs",
          "why": "O(1) exact lookup first; the semantic fallback is entity-filtered so unrelated documents never reach the LLM.",
          "claims": [
            "dia.retrieval",
            "dia.entity_filter"
          ]
        }
      },
      {
        "id": "severity",
        "label": "4-tier severity",
        "sub": "structured · rules · RF · unknown",
        "col": 3,
        "row": 2,
        "detail": {
          "purpose": "Assigns a research severity with explicit consensus rules.",
          "input": "Retrieved evidence",
          "output": "Severity + method + confidence",
          "why": "Trusted metadata wins; the calibrated Random Forest is used only when rules are weak; otherwise the result is 'Unknown'.",
          "observed": "24/24 on the curated regression set (22 via structured metadata).",
          "claims": [
            "dia.four_tier",
            "dia.calibration",
            "dia.regression24"
          ]
        }
      },
      {
        "id": "llm",
        "label": "LLM explanation",
        "sub": "Qwen3-4B (hosted)",
        "col": 4,
        "row": 2,
        "detail": {
          "purpose": "Writes a pair explanation from evidence and severity context.",
          "input": "Evidence + severity",
          "output": "JSON explanation (text fallback)",
          "why": "Generation is bounded: 1 concurrent, 50/day, 1,800 tokens, 40 s.",
          "claims": [
            "dia.llm_provider",
            "dia.llm_bounds"
          ]
        }
      },
      {
        "id": "cache",
        "label": "Response cache",
        "sub": "Redis or LRU",
        "col": 5,
        "row": 2,
        "detail": {
          "purpose": "Avoids repeating identical analyses.",
          "input": "Content-addressed key",
          "output": "Cached report",
          "why": "Keys include the evidence hash and model settings, so a hit means identical inputs; failures are never cached.",
          "observed": "Smoke check: 5.8 s uncached vs 0.25 ms cached (n=1).",
          "claims": [
            "dia.cache_identity",
            "dia.cache_backend",
            "dia.cache_smoke"
          ]
        }
      }
    ],
    "edges": [
      [
        "ui",
