          "claims": [
            "voice.scenarios"
          ]
        }
      },
      {
        "id": "twilio",
        "label": "Twilio",
        "sub": "outbound call + Media Streams",
        "col": 1,
        "row": 0,
        "detail": {
          "purpose": "Places the PSTN call and streams call audio over a WebSocket.",
          "input": "Call request + TwiML <Connect><Stream>",
          "output": "μ-law audio frames + marks",
          "why": "Keeps the media loop visible and debuggable rather than hidden in a managed platform.",
          "claims": [
            "voice.harness"
          ]
        }
      },
      {
        "id": "bridge",
        "label": "FastAPI bridge",
        "sub": "/media WebSocket",
        "col": 2,
        "row": 0,
        "detail": {
          "purpose": "Relays audio both ways, logs both sides and handles barge-in.",
          "input": "Twilio frames / Realtime deltas",
          "output": "Audio to the other side + transcript",
          "why": "μ-law passes through without transcoding.",
          "claims": [
            "voice.harness",
            "voice.ulaw",
            "voice.bargein"
          ]
        }
      },
      {
        "id": "playback",
        "label": "PlaybackState",
        "sub": "barge-in truncation",
        "col": 3,
        "row": 1,
        "detail": {
          "purpose": "Tracks generated vs acknowledged audio and computes the heard cutoff on interruption.",
          "input": "Chunks, marks, speech_started",
          "output": "conversation.item.truncate event",
          "why": "Keeps the model's memory aligned with what the caller actually heard.",
          "claims": [
            "voice.playback_state",
            "voice.bargein"
          ]
        }
      },
      {
        "id": "realtime",
        "label": "OpenAI Realtime",
        "sub": "synthetic patient",
        "col": 3,
        "row": 0,
        "detail": {
          "purpose": "Speech-to-speech model playing the patient persona.",
          "input": "Agent audio",
          "output": "Patient audio + transcript",
          "why": "Built-in turn detection and low latency, where a cascade would add about 1–2 s.",
          "claims": [
            "voice.harness"
          ]
        }
      },
      {
        "id": "capture",
        "label": "Transcripts + recordings",
        "sub": "12 saved calls",
        "col": 1,
        "row": 1,
        "detail": {
          "purpose": "Durable evidence for every call.",
          "input": "Bridge logs, Twilio recordings",
          "output": ".txt / .json transcripts, dual-channel MP3",
          "why": "Makes each failure replayable and reviewable.",
          "claims": [
            "voice.scenarios"
          ]
        }
      },
      {
        "id": "judge",
        "label": "Claude judge",
        "sub": "schema-validated",
        "col": 2,
        "row": 1,
        "detail": {
          "purpose": "Grades containment, task completion, rules, memory, safety and quality.",
          "input": "Transcript",
          "output": "Validated grade + bugs with evidence quotes",
          "why": "A different model from the speaker; malformed grades are rejected.",
          "claims": [
            "voice.judge",
            "voice.grade_validation"
          ]
        }
      },
      {
        "id": "vq",
        "label": "Voice-quality analysis",
        "sub": "VAD on dual channels",
        "col": 0,
        "row": 1,
        "detail": {
          "purpose": "Measures talk-over, silence and turn gaps from the audio.",
          "input": "Dual-channel recordings",
          "output": "Per-call metrics",
          "observed": "0.3% talk-over, 43.9% silence, 0.5 s mean gap.",
          "why": "Puts numbers on 'the agent feels slow'.",
          "claims": [
            "voice.quality"
          ]
        }
      },
      {
        "id": "gate",
        "label": "Regression gate",
        "sub": "compare_runs.py · fail closed",
        "col": 4,
        "row": 1,
        "detail": {
          "purpose": "Blocks a release on missing, malformed, unsafe or regressed results.",
          "input": "baseline.json + new scorecard",
          "output": "Pass or a list of failures",
          "observed": "Currently fails: 3 of 15 scenarios unrecorded.",
          "why": "An incomplete suite must not pass.",
          "claims": [
            "voice.gate",
            "voice.gate_honest",
            "voice.tests"
          ]
        }
      }
