    "id": "arch.sssd",
    "entity": "sssd",
    "title": "Kinematics-conditioned Stable Diffusion",
    "note": "Training and inference path; diagnostics shown beneath.",
    "lanes": [],
    "nodes": [
      {
        "id": "kin",
        "label": "Kinematics + gesture",
        "sub": "76-dim · 30 Hz",
