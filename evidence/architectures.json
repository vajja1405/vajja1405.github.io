            "sssd.diagnostics"
          ]
        }
      },
      {
        "id": "eval",
        "label": "Evaluation",
        "sub": "PSNR/SSIM · cross-pair · FID · flicker",
        "col": 4,
        "row": 0,
        "detail": {
