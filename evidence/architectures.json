          "claims": [
            "sssd.encoder"
          ]
        }
      },
      {
        "id": "enc",
        "label": "KinematicEncoder",
        "sub": "→ [B, 77, 768]",
        "col": 1,
        "row": 0,
        "detail": {
          "purpose": "Projects motion into the U-Net's cross-attention space, replacing CLIP text embeddings.",
          "input": "Kinematics + gesture id",
          "output": "77 conditioning tokens",
          "claims": [
            "sssd.encoder"
          ]
        }
      },
      {
        "id": "unet",
        "label": "SD U-Net + LoRA",
        "sub": "~1% trainable",
        "col": 2,
        "row": 0,
        "detail": {
          "purpose": "Predicts noise in latent space, conditioned on motion.",
